# Never put real credentials in tracked examples. Copy locally and supply your own values.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Production: generate at least 32 random bytes encoded as 64+ hex characters.
# No fallback; never reuse a historical or example secret.
JWT_SECRET=
# Comma-separated exact origins, no trailing slash. Production requires HTTPS.
CLIENT_URL=http://localhost:5173
# Blank = no proxy trusted. Set explicit proxy IPs/CIDRs only after verifying topology.
TRUST_PROXY=

# Phase 5D: disabled by default. No email is sent until explicitly configured.
# http uses an authorized HTTPS gateway accepting JSON {from,to,subject,text}.
CREDENTIAL_MAIL_TRANSPORT=disabled
CREDENTIAL_APP_ORIGIN=https://reporting.example.invalid
CREDENTIAL_MAIL_ENDPOINT=https://mail-gateway.example.invalid/send
CREDENTIAL_MAIL_FROM=reporting@example.invalid
CREDENTIAL_MAIL_API_KEY=
# Explicit comma-separated recipients. No wildcard; keep empty until an authorized mailbox pilot.
CREDENTIAL_MAIL_ALLOWED_RECIPIENTS=
# UTC token durations: setup 900..86400; reset 300..3600 seconds.
SETUP_TOKEN_SECONDS=86400
RESET_TOKEN_SECONDS=1800
# Measured bcrypt work factor, allowed 10..14. Never a plaintext default password.
PASSWORD_BCRYPT_COST=12
